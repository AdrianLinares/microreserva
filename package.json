{
  "name": "microreserva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "PORT=3001 tsx watch server/src/index.ts",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build:frontend": "vite build",
    "build:backend": "tsc --project ./server/tsconfig.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start:backend": "node server/dist/index.js",
    "generate-hash": "node scripts/generate-hash.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.563.0",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.13",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.8.7",
    "netlify-cli": "^17.35.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.1"
  }
}

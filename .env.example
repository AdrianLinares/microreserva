# ==========================
# MICRORESERVA CON EXPRESS - DESPLIEGUE CORPORATIVO SGC
# ==========================

# Puerto donde corre el backend interno de Node
PORT=3000
NODE_ENV=production

# Base de datos (PostgreSQL Corporativo)
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Configuración de Orígenes Permitidos (CORS separado por comas)
CORS_ORIGIN=http://granate.sgc.gov.co,https://granate.sgc.gov.co,http://localhost:5173

# Autenticación de Administradores (JSON Array)
# Contraseñas cifradas con bcrypt usando: npm run generate-hash ADMIN mipassword
ADMIN_USERS=[{"username":"admin", "passwordHash":"$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/"}]

# Configuración de Logs (info, debug, error)
LOG_LEVEL=info

# URL base de la API (para compilar Vite)
VITE_API_URL=/api

# ==========================
# CONFIGURACIÓN SMTP (NOTIFICACIONES)
# ==========================
SMTP_HOST=smtp.sgc.gov.co
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@sgc.gov.co
SMTP_PASS=tu_password_aqui
SMTP_FROM_NAME=Sala de Petrografía - Sistema de Reservas
SMTP_FROM_EMAIL=no-reply@sgc.gov.co
# Si el servidor del SGC usa certificados autofirmados:
SMTP_TLS_REJECT_UNAUTHORIZED=false

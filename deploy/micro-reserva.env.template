# Micro-Reserva environment template (PRODUCTION)
# Rellene los valores reales antes de copiar a /etc/micro-reserva.env
NODE_ENV=production
PORT=3000
TZ=America/Bogota

# Postgres connection (cambiar usuario/clave/host/puerto según correspondan)
DATABASE_URL=postgres://micro_user:SECRETA@localhost:5432/microreserva
DB_SSL=false

# CORS y dominio público interno
CORS_ORIGIN=https://micro-reserva.sgc.gov.co
